{
  "window.commandCenter": false,
  "editor.fontSize": 16,
  "editor.fontFamily": "Fira Code",
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font Mono",
  "workbench.iconTheme": "symbols",
  "editor.cursorSmoothCaretAnimation": "on",
  "workbench.sideBar.location": "right",
  "editor.lineHeight": 1.4,
  "editor.rulers": [80],
  "editor.fontLigatures": true,
  "workbench.editor.labelFormat": "short",
  "explorer.compactFolders": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "workbench.statusBar.visible": false,
  "breadcrumbs.enabled": false,
  "editor.formatOnSave": true,
  "workbench.navigationControl.enabled": false,
  "editor.parameterHints.enabled": false,
  "editor.matchBrackets": "never",
  // "editor.occurrencesHighlight": "off",
  "editor.renderLineHighlight": "gutter",
  "symbols.hidesExplorerArrows": false,
  "editor.minimap.autohide": true,
  "workbench.activityBar.location": "hidden",
  "editor.minimap.enabled": false,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  // "editor.letterSpacing": -0.5, // Retained for spacing consistency
  "editor.fontWeight": "450", // Increased from "normal" to make fonts "fatter"
  "terminal.integrated.fontWeight": "500", // Match terminal font weight to editor
  // "editor.fontVariations": false, // Disable variable font tweaks to ensure consistent weight
  "terminal.integrated.fontSize": 14,
  "editor.defaultFormatter": "ms-python.autopep8",
  "files.saveConflictResolution": "overwriteFileOnDisk",
  "workbench.colorTheme": "Min Dark",
  "jupyter.askForKernelRestart": false,
}
